# QU-Gate settings. setup.sh copies this file to .env. Put your keys in .env (never in .env.example).
# With no key at all, the app runs in DEMO MODE (no real model).

# 1) Google AI Studio key (free). Create it at https://aistudio.google.com  ->  "Get API key"
GOOGLE_API_KEY=

# 2) Groq key (free, optional backup model). Create it at https://console.groq.com/keys
GROQ_API_KEY=

# 3) Only if your hackathon requires OpenAI. Remove the # from QUGATE_MODEL and put the model id you were given.
OPENAI_API_KEY=
# QUGATE_MODEL=openai:PUT-MODEL-ID-HERE
# QUGATE_FALLBACK=

# 4) Optional tracing. Create a free project at https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
